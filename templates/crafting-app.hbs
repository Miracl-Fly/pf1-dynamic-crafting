<div class="pf1-crafting-app">
  {{#unless craftingState.isCrafting}}
    <!-- ================= 准备阶段 ================= -->
    <div class="crafting-section">
      <h3>1. 选择基础物品与配置</h3>
      
      <div class="form-group" id="upgrade-toggle-group" style="margin-bottom: 12px; background: #f0f8ff; padding: 8px; border: 1px solid #b0c4de; border-radius: 4px;">
        <label style="display: flex; align-items: center; cursor: pointer; color: #1e90ff; font-weight: bold;">
          <input type="checkbox" id="is-upgrading" style="width: auto; margin-right: 8px;">
          <span>强化现有物品 (计算差价)</span>
        </label>
      </div>

      <div class="form-group">
        <label>类型：</label>
        <select id="item-type">
          <option value="simple">简易武器</option>
          <option value="martial">军用武器</option>
          <option value="exotic">异种武器 (含火器)</option>
          <option value="light">轻甲</option>
          <option value="medium">中甲</option>
          <option value="heavy">重甲</option>
          <option value="shield">盾牌</option>
          <option value="wondrous">奇物</option>
        </select>
      </div>

      <div id="equipment-fields">
        <div class="form-group" id="base-item-group">
          <label>基础物品：</label>
          <select id="base-item"></select>
        </div>
        
        <div class="form-group" id="upgrade-item-group" style="display: none;">
          <label>选择要强化的物品：</label>
          <select id="upgrade-item"></select>
        </div>

        <div class="form-group" id="enhancement-group">
          <label>增强加值 (+1 ~ +5)：</label>
          <input type="number" id="enhancement" value="1" min="1" max="5">
        </div>
        <div class="form-group" id="ability-group">
          <label>特殊能力：</label>
          <select id="special-ability">
            <option value="0" data-name="" data-cl="0" data-bonus="0" data-price="0" data-desc="">无</option>
          </select>
        </div>
      </div>

      <!-- 奇物搜索：强化和新造都可以用 -->
      <div id="wondrous-fields" style="display: none;">
        <div class="form-group">
          <label>搜索新奇物 (可选)：</label>
          <div style="display: flex; gap: 5px;">
            <input type="text" id="specific-search-input" placeholder="例如：Belt of Giant Strength" style="flex: 1;">
            <button type="button" data-action="search-specific" class="craft-button" style="width: auto; padding: 0 10px; margin: 0;">搜索</button>
          </div>
        </div>
        <div id="specific-search-results" style="max-height: 150px; overflow-y: auto; border: 1px solid #ccc; margin-top: 5px; display: none; background: #fff; border-radius: 4px;"></div>
        <div id="specific-selected" style="margin-top: 10px; display: none; padding: 8px; background: #eaf2f8; border: 1px solid #2980b9; border-radius: 4px;">
          <p style="margin: 0;"><strong>已选择：</strong> <span id="selected-item-name"></span></p>
          <p style="margin: 0; font-size: 0.9em; color: #666;">价格：<span id="selected-item-price"></span> gp | CL：<span id="selected-item-cl"></span></p>
        </div>
      </div>
    </div>

    <div class="crafting-section preview-section">
      <h3>2. 物品属性预览</h3>
      <p><strong>物品 CL：</strong> <span id="item-cl">0</span></p>
      <p><strong>等效总加值：</strong> <span id="total-bonus-preview">+0</span></p>
      <p id="old-price-container" style="display: none;"><strong>原物品价格：</strong> <span id="old-price-preview">0</span> gp</p>
      <p><strong>新物品总价：</strong> <span id="market-price">0</span> gp</p>
      <!-- 差价显示 -->
      <p id="diff-price-container" style="display: none;"><strong>新旧物品差价：</strong> <span id="diff-price-preview" style="font-weight: bold;">0</span> gp</p>
    </div>

    <div class="crafting-section">
      <h3>3. 准备素体 (Preparing the Vessel)</h3>
      <p style="font-size: 0.9em; color: #666;">每个任务需指派一名造物者，同一角色不能同时承担两个任务。</p>
      <p id="vessel-dc-text" style="font-size: 0.9em; color: #666; margin-bottom: 8px;"></p>

      <div class="form-group" style="margin-bottom: 12px; background: #fdf6e3; padding: 8px; border: 1px solid #dcd0b3; border-radius: 4px;">
        <label style="display: flex; align-items: center; cursor: pointer; color: #d35400; font-weight: bold;">
          <input type="checkbox" id="is-adventuring" style="width: auto; margin-right: 8px;">
          <span>冒险途中造物（每日进度减半）</span>
        </label>
      </div>

      <div class="task-row">
        <div class="task-header">
          <select id="vessel-task-1" class="task-skill">
            <option value="spl" data-display="法术辨识" data-dc="15+CL">任务 1：法术辨识</option>
            <option value="crf" data-display="工艺" data-dc="15+CL">任务 1：工艺</option>
            <option value="none" data-display="" data-dc="0">放弃任务 1</option>
          </select>
          <select id="vessel-actor-1" class="task-actor">
            {{#each actors}}<option value="{{this.id}}" data-skills='{{this.skillsJSON}}'>{{this.name}}</option>{{/each}}
          </select>
          <input type="number" id="vessel-base-1" class="task-base" value="0" readonly>
          <input type="number" id="vessel-temp-1" class="task-temp" value="0" placeholder="临时加值">
        </div>
      </div>

      <div class="task-row">
        <div class="task-header">
          <select id="vessel-task-2" class="task-skill">
            <option value="crf" data-display="工艺" data-dc="15+CL">任务 2：工艺</option>
            <option value="spl" data-display="法术辨识" data-dc="15+CL">任务 2：法术辨识</option>
            <option value="none" data-display="" data-dc="0" selected>放弃任务 2</option>
          </select>
          <select id="vessel-actor-2" class="task-actor">
            {{#each actors}}<option value="{{this.id}}" data-skills='{{this.skillsJSON}}'>{{this.name}}</option>{{/each}}
          </select>
          <input type="number" id="vessel-base-2" class="task-base" value="0" readonly>
          <input type="number" id="vessel-temp-2" class="task-temp" value="0" placeholder="临时加值">
        </div>
      </div>

      <button type="button" data-action="prepare-vessel" class="craft-button">
        <i class="fas fa-hammer"></i> 掷骰准备素体
      </button>
    </div>
  {{else}}
    <!-- 制造 / 挑战 / 完成阶段 -->
    <div class="crafting-section preview-section">
      <h3>制造进度</h3>
      <p><strong>当前天数：</strong> <span id="current-day">{{craftingState.currentDay}}</span> / {{craftingState.totalDays}} 天</p>
      <p><strong>造物进度：</strong> <span id="current-progress">{{craftingState.currentProgress}}</span> / {{craftingState.targetProgress}} GP</p>
      {{#if craftingState.isAdventuring}}
        <p style="color: #d35400; font-size: 0.85em; margin-top: 4px;"><em>(冒险途中，每日产出减半)</em></p>
      {{/if}}
      
      {{#if craftingState.perks.length}}
      <div style="margin-top: 8px; border-top: 1px dashed #ccc; padding-top: 8px;">
        <p style="color: green; margin: 0;"><strong>优点：</strong> {{#each craftingState.perks}}{{this.name}}、{{/each}}</p>
      </div>
      {{/if}}
      {{#if craftingState.quirks.length}}
      <div style="margin-top: 4px;">
        <p style="color: #b8860b; margin: 0;"><strong>异常：</strong> {{#each craftingState.quirks}}{{this.name}}、{{/each}}</p>
      </div>
      {{/if}}
      {{#if craftingState.flaws.length}}
      <div style="margin-top: 4px;">
        <p style="color: red; margin: 0;"><strong>瑕疵：</strong> {{#each craftingState.flaws}}{{this.name}}、{{/each}}</p>
        <p style="color: #666; font-size: 0.85em; margin: 0;">(当前瑕疵掷骰修正：+{{craftingState.flawModifier}})</p>
      </div>
      {{/if}}

      {{#if craftingState.isFinalDay}}
        <div style="border: 2px dashed #2980b9; padding: 10px; margin-top: 10px; background: #eaf2f8;">
          <h4 style="color: #2980b9; margin: 0 0 5px 0;">🏁 最后一步：完成物品</h4>
          <p id="final-dc-text" style="font-size: 0.9em; color: #666; margin-bottom: 8px;"></p>
          
          <div class="task-row">
            <div class="task-header">
              <select id="final-task-1" class="task-skill">
                <option value="umd" data-display="使用魔法装置" data-dc="15+CL">任务 1：即兴创作 (使用魔法装置)</option>
                <option value="conditions" data-display="" data-dc="0">任务 1：提供条件 (直接成功)</option>
                <option value="none" data-display="" data-dc="0">放弃任务 1</option>
              </select>
              <select id="final-actor-1" class="task-actor">
                {{#each actors}}<option value="{{this.id}}" data-skills='{{this.skillsJSON}}'>{{this.name}}</option>{{/each}}
              </select>
              <input type="number" id="final-base-1" class="task-base" value="0" readonly>
              <input type="number" id="final-temp-1" class="task-temp" value="0" placeholder="临时加值">
            </div>
          </div>
          <div class="task-row">
            <div class="task-header">
              <select id="final-task-2" class="task-skill">
                <option value="conditions" data-display="" data-dc="0">任务 2：提供条件 (直接成功)</option>
                <option value="umd" data-display="使用魔法装置" data-dc="15+CL">任务 2：即兴创作 (使用魔法装置)</option>
                <option value="none" data-display="" data-dc="0" selected>放弃任务 2</option>
              </select>
              <select id="final-actor-2" class="task-actor">
                {{#each actors}}<option value="{{this.id}}" data-skills='{{this.skillsJSON}}'>{{this.name}}</option>{{/each}}
              </select>
              <input type="number" id="final-base-2" class="task-base" value="0" readonly>
              <input type="number" id="final-temp-2" class="task-temp" value="0" placeholder="临时加值">
            </div>
          </div>
          <button type="button" data-action="complete-item" class="craft-button" style="background: #2980b9;">
            <i class="fas fa-flag-checkered"></i> 完成造物
          </button>
        </div>
      {{else if craftingState.isChallengeDay}}
        <!-- 挑战日 UI -->
        <div style="border: 2px dashed #d35400; padding: 10px; margin-top: 10px; background: #fdebd0;">
          <h4 style="color: #d35400; margin: 0 0 5px 0;">⚠️ 挑战日！</h4>
          {{#if craftingState.currentChallenge}}
            <div style="margin-bottom: 10px; padding: 8px; background: #fff; border: 1px solid #ccc; border-radius: 4px;">
              <strong>当前挑战：{{craftingState.currentChallenge.name}}</strong>
              <p style="font-size: 0.9em; margin: 4px 0 0 0;">{{craftingState.currentChallenge.desc}}</p>
            </div>
            {{#if craftingState.currentChallenge.isPrestige}}
              <div class="form-group" style="margin-bottom: 10px; background: #fff; padding: 8px; border: 1px solid #d35400; border-radius: 4px;">
                <label style="color: #d35400; font-weight: bold; display: block; margin-bottom: 4px;">请选择适用的职业专属挑战：</label>
                <select id="prestige-select" style="width: 100%; padding: 4px;">
                  <option value="-1">-- 请选择 --</option>
                  {{#each craftingState.currentChallenge.prestigeOptions}}
                    <option value="{{this.index}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                  {{/each}}
                </select>
              </div>
            {{/if}}
            {{#if craftingState.currentChallenge.results}}
            <p style="font-size: 0.9em; color: #666; margin-bottom: 8px;">
              <strong>大成功：</strong> {{{craftingState.currentChallenge.results.cs.html}}}<br>
              <strong>成功：</strong> 
              {{#if craftingState.currentChallenge.results.s.task1}}
                任务1：{{{craftingState.currentChallenge.results.s.task1.html}}}<br>
                任务2：{{{craftingState.currentChallenge.results.s.task2.html}}}
              {{else}}
                {{{craftingState.currentChallenge.results.s.html}}}
              {{/if}}<br>
              <strong>失败：</strong> {{{craftingState.currentChallenge.results.f.html}}}<br>
              <strong>大失败：</strong> {{{craftingState.currentChallenge.results.cf.html}}}
            </p>
            {{else}}
            <p id="challenge-dc-text" style="font-size: 0.9em; color: #666; margin-bottom: 8px;">
              <span style="color:red">请先选择具体的职业专属挑战以查看效果。</span>
            </p>
            {{/if}}

            <div class="task-row"><div class="task-header">
              <select id="challenge-task-1" class="task-skill">
                {{#if craftingState.currentChallenge.task1}}
                  {{#if craftingState.currentChallenge.task1.options}}
                    {{#each craftingState.currentChallenge.task1.options}}
                      <option value="{{this.key}}" data-display="{{this.name}}" data-dc="{{../craftingState.currentChallenge.task1.dc}}" data-type="{{../craftingState.currentChallenge.task1.type}}">任务 1：{{this.name}}</option>
                    {{/each}}
                  {{else}}
                    <option value="{{craftingState.currentChallenge.task1.key}}" data-display="{{craftingState.currentChallenge.task1.name}}" data-dc="{{craftingState.currentChallenge.task1.dc}}" data-type="{{craftingState.currentChallenge.task1.type}}">任务 1：{{craftingState.currentChallenge.task1.name}}</option>
                  {{/if}}
                {{/if}}
                <option value="none" data-display="" data-dc="0" data-type="skill">放弃任务 1</option>
              </select>
              <select id="challenge-actor-1" class="task-actor">{{#each actors}}<option value="{{this.id}}" data-skills='{{this.skillsJSON}}'>{{this.name}}</option>{{/each}}</select>
              <input type="number" id="challenge-base-1" class="task-base" value="0" readonly>
              <input type="number" id="challenge-temp-1" class="task-temp" value="0" placeholder="加值">
            </div></div>

            <div class="task-row"><div class="task-header">
              <select id="challenge-task-2" class="task-skill">
                {{#if craftingState.currentChallenge.task2}}
                  {{#if craftingState.currentChallenge.task2.options}}
                    {{#each craftingState.currentChallenge.task2.options}}
                      <option value="{{this.key}}" data-display="{{this.name}}" data-dc="{{../craftingState.currentChallenge.task2.dc}}" data-type="{{../craftingState.currentChallenge.task2.type}}">任务 2：{{this.name}}</option>
                    {{/each}}
                  {{else}}
                    <option value="{{craftingState.currentChallenge.task2.key}}" data-display="{{craftingState.currentChallenge.task2.name}}" data-dc="{{craftingState.currentChallenge.task2.dc}}" data-type="{{craftingState.currentChallenge.task2.type}}">任务 2：{{craftingState.currentChallenge.task2.name}}</option>
                  {{/if}}
                {{/if}}
                <option value="none" data-display="" data-dc="0" data-type="skill" selected>放弃任务 2</option>
              </select>
              <select id="challenge-actor-2" class="task-actor">{{#each actors}}<option value="{{this.id}}" data-skills='{{this.skillsJSON}}'>{{this.name}}</option>{{/each}}</select>
              <input type="number" id="challenge-base-2" class="task-base" value="0" readonly>
              <input type="number" id="challenge-temp-2" class="task-temp" value="0" placeholder="加值">
            </div></div>

            <button type="button" data-action="resolve-challenge" class="craft-button" style="background: #d35400;">
              <i class="fas fa-dice-d20"></i> 掷骰应对挑战
            </button>
          {{else}}
            <p>你遭遇了未知的波折，请掷骰决定具体挑战。</p>
            <button type="button" data-action="roll-challenge-type" class="craft-button" style="background: #d35400;">
              <i class="fas fa-dice-d100"></i> 掷 D100 决定挑战
            </button>
          {{/if}}
        </div>
      {{else}}
        <button type="button" data-action="next-day" class="craft-button">
          <i class="fas fa-calendar-day"></i> 推进一天
        </button>
      {{/if}}
    </div>
  {{/unless}}
</div>
